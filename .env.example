DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lastbite_dev"
JWT_SECRET="change-me-in-production-use-64-char-random-string"
JWT_REFRESH_SECRET="change-me-too-different-from-jwt-secret"
PORT=4000

# Upload
UPLOAD_PROVIDER=local
UPLOAD_LOCAL_DIR=uploads
UPLOAD_MAX_SIZE=5242880

# Image variants (in pixels, applied to all uploads)
UPLOAD_VARIANT_THUMB_SIZE=200
UPLOAD_VARIANT_CARD_SIZE=400
UPLOAD_VARIANT_FULL_SIZE=800
UPLOAD_VARIANT_QUALITY=80

# S3-compatible storage (used when UPLOAD_PROVIDER=s3)
# For DigitalOcean Spaces, set S3_ENDPOINT to the regional endpoint
# and S3_PUBLIC_URL to the CDN URL.
#
# Example: DigitalOcean Spaces (Singapore region)
#   S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
#   S3_REGION=sgp1
#   S3_BUCKET=lastbite-uploads
#   S3_PUBLIC_URL=https://lastbite-uploads.sgp1.cdn.digitaloceanspaces.com
#
# Example: AWS S3 (Singapore region)
#   S3_REGION=ap-southeast-1
#   S3_BUCKET=lastbite-uploads
#   (S3_ENDPOINT and S3_PUBLIC_URL optional for AWS)
#
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_PUBLIC_URL=

# Google Maps (geocoding, map display)
GOOGLE_MAPS_API_KEY=

# Firebase FCM (push notifications)
# Saat diisi dengan project ID asli, push notification akan dikirim via FCM.
# Jika dibiarkan 'test-project', push akan di-mock (log ke console saja).
FIREBASE_PROJECT_ID=test-project
# JSON string dari service account key Firebase. Dapatkan dari:
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...",...}'
